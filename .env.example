# Standalone defaults. These are also the built-in fallbacks, so
# `docker compose up -d --build` works immediately after cloning with no .env.

# Where the app is published on the host.
#   local : 127.0.0.1:3081 — reachable from this machine and nothing else
#   LIVE  : APP_BIND=0.0.0.0 and APP_PORT=80 for a public standalone deployment,
#           with your own TLS terminator in front
APP_BIND=127.0.0.1
APP_PORT=3081

# Only read by docker-compose.traefik.yml, so it is unused in standalone mode.
APP_HOST=baby.localhost
