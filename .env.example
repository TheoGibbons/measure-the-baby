# Local browser address. Set this to the public DNS name on EC2.
APP_HOST=localhost

# Host-side port. Change this if 3081 is already in use.
APP_PORT=3081

# Use false for local HTTP and true when serving HTTPS through Traefik.
COOKIE_SECURE=false

# Use false locally. Set this to true on EC2.
TRAEFIK_ENABLED=false

# Local network settings. On EC2, set TRAEFIK_NETWORK to the network shared
# with Traefik and set TRAEFIK_NETWORK_EXTERNAL=true.
TRAEFIK_NETWORK=measure-the-baby-local
TRAEFIK_NETWORK_EXTERNAL=false

# Names from the Traefik static configuration.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
