# Copy to .env on the server. Both LIVE paths read this file; which lines matter
# depends on which one you follow.

# --- Deploying to LIVE (standalone, no Traefik) ------------------------------
# Publishes the app publicly on port 80. Put your own TLS terminator in front —
# Cloudflare, nginx or Caddy. Ignored by the Traefik path below, which does not
# load docker-compose.override.yml at all.
APP_BIND=0.0.0.0
APP_PORT=80

# --- Deploying to LIVE with hobby-traefik ------------------------------------
# Public DNS name, pointed at this instance before deploying so Let's Encrypt
# can validate it.
APP_HOST=baby.example.com
